# Reproducible compute environment: Python package + OpenFOAM v11 for
# the cross-check cases. The stent_hemo package installs into the
# OpenFOAM image so one container runs everything.
FROM openfoam/openfoam11-paraview510

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
RUN python3 -m pip install --no-cache-dir -e .[dev]

# OpenFOAM cases are generated by the pipeline; the Allrun script inside
# each case directory runs them with the v11 `foamRun` solver.
COPY --chmod=755 docker/run_openfoam.sh /usr/local/bin/run_openfoam

CMD ["bash", "-lc", "stent-hemo all --quick"]
